      "vulnerability": {
        "name": "RUSTSEC-2024-0370"
      },
      "products": [
        {
          "@id": "pkg:oci/cassiopeia?repository_url=ghcr.io/vela-tools/cassiopeia",
          "subcomponents": [
            {
              "@id": "pkg:cargo/proc-macro-error@1.0.4"
            }
          ]
        },
        {
          "@id": "pkg:docker/vela-tools/cassiopeia?repository_url=ghcr.io",
          "subcomponents": [
            {
              "@id": "pkg:cargo/proc-macro-error@1.0.4"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "component_not_present",
      "impact_statement": "proc-macro-error 1.0.4 is unmaintained, which the advisory reports in place of a vulnerability. Only the procedural macros of static-automata-macros 1.1.0, static-regular-grammar 2.0.2 and str-newtype-derive 2.0.0 use it, so it runs while Cassiopeia compiles and none of its code is in the binary."
    },
    {
      "vulnerability": {
        "name": "RUSTSEC-2026-0459",
        "aliases": [
          "CVE-2026-119375",
          "GHSA-72w2-rjgg-q729"
        ]
      },
      "products": [
        {
          "@id": "pkg:oci/cassiopeia?repository_url=ghcr.io/vela-tools/cassiopeia",
          "subcomponents": [
            {
              "@id": "pkg:cargo/libsqlite3-sys@0.38.2"
            }
          ]
        },
        {
          "@id": "pkg:docker/vela-tools/cassiopeia?repository_url=ghcr.io",
          "subcomponents": [
            {
              "@id": "pkg:cargo/libsqlite3-sys@0.38.2"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "The image builds Cassiopeia without the geopackage-bundled feature, so libsqlite3-sys 0.38.2 compiles none of the SQLite it bundles, and links SQLite 3.54.1 instead, which the image build compiles from the official source and which carries the fix."
    },
