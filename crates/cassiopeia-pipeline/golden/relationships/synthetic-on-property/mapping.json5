// A `syntheticEntity` declared on a Property, an attribute that links nothing, writes no entity:
// loading the mapping warns that the key has no effect.
{
    version: "v4",
    dataModel: "Asset",
    identity: {
        entityName: "{{ code }}",
    },
    attributes: {
        ownerName: {
            source: "{{ owner_name }}",
            syntheticEntity: {
                dataModel: "Organization",
                identity: {
                    entityName: "{{ owner_id }}",
                },
                attributes: {
                    name: {
                        source: "{{ owner_name }}",
                    },
                },
            },
        },
    },
}
