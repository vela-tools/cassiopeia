// Reads each place from a member no record holds, so the entity has readings of a moving Thing but
// no `location` at all.
{
    version: "v4",
    dataModel: "dataModel.Environment/AirQualityObserved",
    identity: {
        entityName: "bus-{{ thing.id }}",
    },
    attributes: {
        location: {
            type: "GeoProperty",
            source: "{{ historicalLocation.place }}",
            properties: {
                observedAt: {
                    source: "{{ historicalLocation.time }}",
                    transformation: "datetime",
                },
            },
        },
        dateObserved: {
            source: "{{ readings.pm10.time }}",
            transformation: "datetime",
        },
        pm10: {
            source: "{{ readings.pm10.result }}",
            transformation: "float",
            properties: {
                observedAt: {
                    source: "{{ readings.pm10.time }}",
                    transformation: "datetime",
                },
            },
        },
    },
}
