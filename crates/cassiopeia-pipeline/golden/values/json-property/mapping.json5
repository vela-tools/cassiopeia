// A JsonProperty keeps an object or an array of objects as the source holds it, nulls included.
// With no transformation, as under `json`, it decodes text; `object` keeps an object, and `array`
// gathers objects; anything else is refused with a warning.
{
    version: "v4",
    dataModel: "Sample",
    identity: {
        entityName: "{{ code }}",
    },
    attributes: {
        asIs: {
            type: "JsonProperty",
            source: "{{ payload }}",
        },
        textByDefault: {
            type: "JsonProperty",
            source: "{{ text }}",
        },
        decoded: {
            type: "JsonProperty",
            source: "{{ text }}",
            transformation: "json",
        },
        emptyObject: {
            type: "JsonProperty",
            source: "{{ empty }}",
            transformation: "object",
        },
        objects: {
            type: "JsonProperty",
            source: [
                "{{ first }}",
                "{{ second }}",
            ],
            transformation: "array",
        },
        mixed: {
            type: "JsonProperty",
            source: "{{ mixed }}",
            transformation: "array",
        },
    },
}
