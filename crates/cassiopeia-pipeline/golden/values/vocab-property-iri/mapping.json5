// A VocabProperty that declares `transformation: "iri"` reads as one that declares none: an
// absolute IRI, written in its normal form. A value that is no IRI is dropped with a warning.
{
    version: "v4",
    dataModel: "Sample",
    identity: {
        entityName: "{{ code }}",
    },
    attributes: {
        category: {
            type: "VocabProperty",
            source: "{{ category }}",
            transformation: "iri",
        },
    },
}
