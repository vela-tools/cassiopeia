// A GeoProperty that declares `transformation: "geometry"` reads as one that declares none: a
// GeoJSON object or its JSON text, of whichever admissible type. A value that spells no geometry is
// dropped with a warning.
{
    version: "v4",
    dataModel: "Sample",
    identity: {
        entityName: "{{ code }}",
    },
    attributes: {
        location: {
            type: "GeoProperty",
            source: "{{ location }}",
            transformation: "geometry",
        },
    },
}
