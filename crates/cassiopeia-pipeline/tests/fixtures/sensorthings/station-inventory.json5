{
    version: "v4",
    dataModel: "dataModel.Device/Device",
    identity: {
        entityName: "sta-{{ server.host }}-{{ thing.id }}",
    },
    attributes: {
        name: { source: "{{ thing.name }}" },
        description: { source: "{{ thing.description }}" },
        location: { type: "GeoProperty", source: "{{ location }}" },
    },
}
