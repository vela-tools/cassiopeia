{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Movie",
    "type": "object",
    "required": [
        "id",
        "type"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^urn:ngsi-ld:Movie:"
        },
        "type": {
            "const": "Movie"
        },

        "title": {
            "type": "object",
            "required": [
                "type",
                "value"
            ],
            "properties": {
                "type": {
                    "const": "Property"
                },
                "value": {
                    "type": "string"
                }
            }
        },

        "hasLeadActor": {
            "type": "object",
            "required": [
                "type",
                "object"
            ],
            "properties": {
                "type": {
                    "const": "Relationship"
                },
                "object": {
                    "type": "string",
                    "pattern": "^urn:ngsi-ld:Person:"
                },
                "objectType": {
                    "const": "Person"
                },
                "playsCharacter": {
                    "type": "object",
                    "required": [
                        "type",
                        "object"
                    ],
                    "properties": {
                        "type": {
                            "const": "Relationship"
                        },
                        "object": {
                            "type": "string",
                            "pattern": "^urn:ngsi-ld:Character:"
                        },
                        "objectType": {
                            "const": "Character"
                        }
                    }
                },
                "billingOrder": {
                    "type": "object",
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "Property"
                        },
                        "value": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                }
            }
        },

        "hasCast": {
            "type": "object",
            "required": [
                "type",
                "objectList"
            ],
            "properties": {
                "type": {
                    "const": "ListRelationship"
                },
                "objectList": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^urn:ngsi-ld:Person:"
                    }
                },
                "objectType": {
                    "const": "Person"
                },
                "castSize": {
                    "type": "object",
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "Property"
                        },
                        "value": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                }
            }
        }
    }
}
