{
    version: "v4",
    dataModel: "dataModel.Aeronautics/Airport",
    identity: {
        entityName: "{{ this[0] }}",
    },
    attributes: {
        name: {
            source: "{{ this[1] }}",
            type: "Property",
            transformation: "string",
        },
        codeIATA: {
            source: "{% if this[4] is string and this[4] is matching(pat='^[A-Z]{3}$') %}{{ this[4] }}{% endif %}",
            type: "Property",
            transformation: "string",
        },
        codeICAO: {
            source: "{% if this[5] is string and this[5] is matching(pat='^[A-Z]{4}$') %}{{ this[5] }}{% endif %}",
            type: "Property",
            transformation: "string",
        },
        location: {
            source: [
                "{{ this[7] }}",
                "{{ this[6] }}",
            ],
            type: "GeoProperty",
            transformation: "point",
        },
        address: {
            type: "Property",
            transformation: "object",
            mappings: {
                addressLocality: {
                    source: "{{ this[2] }}",
                    type: "Property",
                    transformation: "string",
                },
                addressCountry: {
                    source: "{{ this[3] }}",
                    type: "Property",
                    transformation: "string",
                },
            },
        },
        // The airport's country is a relationship. The source uses the country name, which resolves
        // to the same URN that the country mapping creates from its own name.
        inCountry: {
            source: "{{ this[3] }}",
            type: "Relationship",
            target: {
                entity: "Country",
            },
        },
    },
}
