{
    version: "v4",
    dataModel: "dataModel.Aeronautics/AircraftModel",
    identity: {
        // The IATA code identifies the model, and is what a route's equipment list references. A few
        // models carry no IATA code, so the ICAO code is the fallback identity for those.
        entityName: "{% if this[1] %}{{ this[1] }}{% else %}{{ this[2] }}{% endif %}",
    },
    attributes: {
        name: {
            source: "{{ this[0] }}",
            type: "Property",
            transformation: "string",
        },
        // Every IATA aircraft code in this file already fits the model's `^[A-Z0-9]{3}$` pattern, so
        // it is emitted as text as-is; a purely numeric code such as "747" becomes the string "747".
        codeIATA: {
            source: "{% if this[1] %}{{ this[1] }}{% endif %}",
            type: "Property",
            transformation: "string",
        },
        // The ICAO code is only kept when it fits the model's pattern; several entries do not.
        codeICAO: {
            source: "{% if this[2] is string and this[2] is matching(pat='^[A-Z][A-Z0-9]{3}$') %}{{ this[2] }}{% endif %}",
            type: "Property",
            transformation: "string",
        },
    },
}
